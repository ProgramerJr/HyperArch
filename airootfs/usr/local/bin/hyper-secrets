#!/usr/bin/env bash
# hyper-secrets — cifra las credenciales en reposo con GPG (SE-02).
#
# Sustituye el tokens.env en texto plano por un fichero cifrado que solo se
# descifra en memoria cuando los widgets lo necesitan.
#
#   hyper-secrets init      genera clave y cifra el tokens.env existente
#   hyper-secrets edit      abre el fichero descifrado, lo vuelve a cifrar al salir
#   hyper-secrets show      vuelca las variables (para depurar)
set -euo pipefail

CFG="$HOME/.config/hyperarch"
PLAIN="$CFG/tokens.env"
ENC="$CFG/tokens.env.gpg"

case "${1:-}" in
    init)
        command -v gpg >/dev/null || { echo "gpg no instalado"; exit 1; }
        if ! gpg --list-secret-keys --with-colons 2>/dev/null | grep -q '^sec'; then
            echo "No tienes clave GPG. Generando una..."
            gpg --quick-generate-key "$(whoami)@hyperarch" default default never
        fi
        KEY=$(gpg --list-secret-keys --with-colons | awk -F: '/^uid/{print $10; exit}')
        [[ -f "$PLAIN" ]] || { echo "No hay $PLAIN que cifrar"; exit 1; }
        gpg --yes --encrypt --recipient "$KEY" --output "$ENC" "$PLAIN"
        shred -u "$PLAIN" 2>/dev/null || rm -f "$PLAIN"
        chmod 600 "$ENC"
        echo "Cifrado en $ENC. El fichero en claro se ha borrado de forma segura."
        ;;
    edit)
        [[ -f "$ENC" ]] || { echo "Ejecuta primero: hyper-secrets init"; exit 1; }
        tmp=$(mktemp); chmod 600 "$tmp"
        trap 'shred -u "$tmp" 2>/dev/null || rm -f "$tmp"' EXIT
        gpg --quiet --decrypt "$ENC" > "$tmp"
        "${EDITOR:-nano}" "$tmp"
        KEY=$(gpg --list-secret-keys --with-colons | awk -F: '/^uid/{print $10; exit}')
        gpg --yes --encrypt --recipient "$KEY" --output "$ENC" "$tmp"
        echo "Guardado y cifrado."
        ;;
    show)
        gpg --quiet --decrypt "$ENC"
        ;;
    *)
        echo "uso: hyper-secrets {init|edit|show}"
        ;;
esac
