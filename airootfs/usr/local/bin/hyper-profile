#!/usr/bin/env bash
# hyper-profile — perfiles de carga (CP-02, PR-12, PR-18).
#   dev | ai | gaming | silent
set -euo pipefail

gov() { echo "$1" | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null; }

case "${1:-status}" in
    dev)
        gov performance
        sudo sysctl -qw vm.swappiness=10
        notify-send "HyperArch" "Perfil: Desarrollo (24 hilos, governor performance)"
        ;;
    ai)
        gov performance
        sudo sysctl -qw vm.swappiness=1
        notify-send "HyperArch" "Perfil: IA (VRAM priorizada, swap mínimo)"
        ;;
    gaming)
        gov performance
        sudo sysctl -qw vm.swappiness=1
        # Steam y los juegos al CCD con V-Cache: menos latencia, más FPS
        # en títulos sensibles a caché. El resto del sistema usa CCD1.
        for pid in $(pgrep -f "steam|gamescope" 2>/dev/null); do
            taskset -pc 0-5,12-17 "$pid" >/dev/null 2>&1 || true
        done
        notify-send "HyperArch" "Perfil: Gaming (CCD0 V-Cache priorizado)"
        ;;
    silent)
        gov powersave
        notify-send "HyperArch" "Perfil: Silencio (powersave)"
        ;;
    status)
        echo "governor: $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor)"
        echo "swappiness: $(cat /proc/sys/vm/swappiness)"
        ;;
    *) echo "uso: hyper-profile {dev|ai|gaming|silent|status}" >&2; exit 1 ;;
esac
