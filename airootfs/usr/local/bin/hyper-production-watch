#!/usr/bin/env bash
# hyper-production-watch — activa Modo Producción cuando hay apps de trabajo
# abiertas y lo desactiva al cerrar la última (FR-32, FR-33).
#
# Escucha el socket de eventos de Hyprland en lugar de sondear, para no
# consumir CPU en bucle.

set -euo pipefail

WORK_CLASSES='^(code|code-url-handler|Code|MongoDB Compass|Postman|jetbrains-.*)$'
STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/hyperarch"
MANUAL_FILE="$STATE_DIR/production.manual"
mkdir -p "$STATE_DIR"

work_windows_open() {
    hyprctl clients -j 2>/dev/null \
        | jq -r '.[].class' \
        | grep -qE "$WORK_CLASSES"
}

evaluate() {
    # El override manual gana siempre (FR-34).
    [[ -f "$MANUAL_FILE" ]] && return 0

    if work_windows_open; then
        hyper-production-mode on
    else
        hyper-production-mode off
    fi
}

SOCKET="${XDG_RUNTIME_DIR}/hypr/${HYPRLAND_INSTANCE_SIGNATURE}/.socket2.sock"

evaluate
socat -U - "UNIX-CONNECT:${SOCKET}" 2>/dev/null | while read -r event; do
    case "$event" in
        openwindow\>\>*|closewindow\>\>*) evaluate ;;
    esac
done
