# Copia a tokens.env y rellena. NUNCA se incluye en la ISO.
#   cp tokens.env.example tokens.env && chmod 600 tokens.env
#
# GitHub  → Settings > Developer settings > Fine-grained tokens (repo, actions:read)
# Netlify → User settings > Applications > Personal access tokens
# Render  → Account Settings > API Keys

GITHUB_USER=ProgramerJr
GITHUB_TOKEN=
NETLIFY_TOKEN=
RENDER_TOKEN=
